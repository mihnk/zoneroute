---
import Base from '../../layouts/Base.astro';

const docs = [
  {
    href: '/docs/install/',
    title: 'Installation',
    summary:
      'Prerequisites and the privileges an install actually needs, the release and kustomize paths, the integration ConfigMap, your first ZoneRoute, and how to verify it.',
  },
  {
    href: '/docs/coredns-wiring/',
    title: 'CoreDNS wiring',
    summary:
      'The seven points of the integration contract, the kubeadm and kind steps that satisfy them, and what is known about managed platforms.',
  },
  {
    href: '/docs/troubleshooting/',
    title: 'Troubleshooting',
    summary:
      'Every Accepted and Published reason with its cause and remedy, plus the path from a name that does not resolve to the component responsible.',
  },
];
---

<Base
  title="Documentation — ZoneRoute"
  description="Installation, CoreDNS wiring and troubleshooting for ZoneRoute, rendered from the repository's canonical Markdown."
  path="docs"
>
  <div class="wrap docs-index">
    <h1>Documentation</h1>
    <p class="lede">
      These pages are rendered from the Markdown in the repository, so what you read here and what
      you read on GitHub are the same file.
    </p>

    <ul class="doc-list">
      {docs.map((doc, i) => (
        <li class="doc-entry">
          <span class="doc-index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h2>
            <a href={doc.href}>{doc.title}</a>
          </h2>
          <p>{doc.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .docs-index {
    padding-block: var(--space-2xl);
  }

  h1 {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  .lede {
    max-width: var(--measure);
    margin-top: var(--space-s);
    color: var(--muted);
    text-wrap: pretty;
  }

  .doc-list {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .doc-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }

  .doc-entry {
    display: grid;
    align-content: start;
    padding-top: var(--space-s);
    border-top: var(--border-hairline);
  }

  .doc-index {
    color: var(--muted);
    font-size: var(--step-00);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .doc-entry h2 {
    margin-top: var(--space-2xs);
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .doc-entry h2 a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .doc-entry h2 a:hover {
    border-bottom-color: var(--text);
  }

  .doc-entry p {
    margin-top: var(--space-2xs);
    color: var(--muted);
    font-size: var(--step-00);
    text-wrap: pretty;
  }
</style>
