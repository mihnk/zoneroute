---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  /** The canonical Markdown file this page is rendered from. */
  source: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, path, source, headings } = Astro.props;
const repo = 'https://github.com/mihnk/zoneroute';

// Only section headings; the document's own H1 becomes the page title, and
// anything deeper would make the list longer than it is useful.
const sections = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} path={path}>
  <div class="wrap doc-layout">
    {sections.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <h2 class="toc-title">On this page</h2>
        <ul>
          {sections.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <article class="doc">
      <slot />

      <p class="doc-source">
        Rendered from <code>{source}</code> —
        <a href={`${repo}/blob/main/${source}`} rel="noopener noreferrer">
          edit on GitHub
        </a>
        .
      </p>
    </article>
  </div>
</Base>

<style>
  .doc-layout {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-l) var(--space-2xl);
  }

  @media (min-width: 60rem) {
    .doc-layout {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .toc {
      position: sticky;
      top: var(--space-m);
      align-self: start;
      max-height: calc(100vh - var(--space-xl));
      overflow-y: auto;
    }
  }

  .toc-title {
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: var(--space-2xs);
  }

  .toc ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
  }

  .toc a {
    color: var(--muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--text);
  }

  .doc {
    min-width: 0;
    max-width: 46rem;
  }

  /* Markdown comes in unclassed, so it is styled through the container. */
  .doc :global(h1) {
    font-size: var(--step-4);
    margin-bottom: var(--space-m);
  }

  .doc :global(h2) {
    font-size: var(--step-3);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-s);
    padding-top: var(--space-s);
    border-top: var(--border-hairline);
  }

  .doc :global(h3) {
    font-size: var(--step-1);
    margin-top: var(--space-l);
    margin-bottom: var(--space-2xs);
  }

  .doc :global(p),
  .doc :global(ul),
  .doc :global(ol),
  .doc :global(pre),
  .doc :global(blockquote) {
    margin-block: var(--space-s);
  }

  .doc :global(ul),
  .doc :global(ol) {
    padding-left: 1.25rem;
  }

  .doc :global(li) {
    margin-block: 0.25rem;
  }

  .doc :global(a) {
    color: var(--accent);
    text-underline-offset: 2px;
  }

  /* Tables can be wider than the column; they scroll on their own. */
  .doc :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-block: var(--space-s);
  }

  .doc :global(th),
  .doc :global(td) {
    border: var(--border-hairline);
    padding: var(--space-2xs) var(--space-xs);
    text-align: left;
    vertical-align: top;
  }

  .doc :global(th) {
    background-color: var(--surface);
  }

  .doc :global(blockquote) {
    border-left: 3px solid var(--border);
    padding-left: var(--space-s);
    color: var(--muted);
  }

  .doc-source {
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: var(--border-hairline);
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
