---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  /** Path without the leading slash: '' for the homepage, 'docs' for /docs. */
  path: string;
}

const { title, description, path } = Astro.props;
const canonical = new URL(path ? `/${path}/` : '/', Astro.site);
const repo = 'https://github.com/mihnk/zoneroute';
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Runs before first paint. A choice stored on this site wins; otherwise
         the shared *.mihnk.org cookie carries a choice made on another mihnk
         site. With neither, nothing is set and `prefers-color-scheme` decides,
         so the system theme still wins. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'dark' && t !== 'light') {
          var m = document.cookie.match(/(?:^|;\s*)mihnk-theme=(dark|light)/);
          t = m && m[1];
        }
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link
      rel="preload"
      href="/fonts/league-spartan-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZoneRoute" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121315" media="(prefers-color-scheme: dark)" />
  </head>

  <body>
    <div class="page">
      <a class="skip-link" href="#main">
        Skip to content
      </a>

      <header class="masthead">
        {/* The organisation first, then the project it belongs to. */}
        <div class="brand">
          <a class="brandmark" href="https://mihnk.org" rel="noopener noreferrer" lang="en">
            mih<span class="accent">n</span>k
          </a>
          <span class="brand-sep" aria-hidden="true">
            /
          </span>
          <a class="wordmark" href="/">
            ZoneRoute
          </a>
        </div>

        <div class="masthead-controls">
          <nav class="nav" aria-label="Main">
            <a href="/docs/" aria-current={current.startsWith('/docs') ? 'page' : undefined}>
              Docs
            </a>
            <a href={repo} rel="noopener noreferrer">
              GitHub
            </a>
          </nav>
          <ThemeToggle />
        </div>
      </header>

      <main id="main" class="main">
        <slot />
      </main>

      <footer class="footer">
        <p class="footer-top">
          <span class="footer-project">ZoneRoute</span>
          <span>
            A{' '}
            <a href="https://mihnk.org" rel="noopener noreferrer">
              mihnk
            </a>{' '}
            project.
          </span>
        </p>

        <ul class="footer-links">
          <li>
            <a href={repo} rel="noopener noreferrer">
              GitHub
            </a>
          </li>
          <li>
            <a href="/docs/">Docs</a>
          </li>
          <li>
            <a href={`${repo}/releases`} rel="noopener noreferrer">
              Releases
            </a>
          </li>
          <li>
            <a href={`${repo}/blob/main/LICENSE`} rel="noopener noreferrer">
              License
            </a>
          </li>
          <li>
            <a href="mailto:security@mihnk.org">Security</a>
          </li>
        </ul>
      </footer>
    </div>
  </body>
</html>
